.active-owner-search {
  display: grid;
  gap: 8px;
}
.active-owner-list {
  align-content: start;
}
.active-owner-item {
  align-items: center;
}
@media (max-width: 820px) {
  .active-owner-search .form-stack {
    display: grid;
    gap: 10px;
  }
}
.social-stack {
  display: grid;
  gap: 14px;
}
.social-item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16px;
  padding: 18px 20px;
  border-radius: 22px;
  border: 1px solid var(--line);
  background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(247,244,236,.88));
}
.social-item-main {
  display: grid;
  gap: 8px;
}
.social-item-main strong {
  font-family: "Be Vietnam Pro", sans-serif;
  color: var(--forest-deep);
}
.social-actions {
  display: flex;
  gap: 10px;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
}
.social-actions.is-disabled {
  opacity: .72;
}
.social-meta-row,
.member-row-head {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}
.member-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 12px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 800;
  border: 1px solid transparent;
}
.member-badge.is-forest {
  background: rgba(31,107,69,.12);
  color: var(--forest-deep);
  border-color: rgba(31,107,69,.14);
}
.member-badge.is-gold {
  background: rgba(200,169,107,.18);
  color: #7a5a21;
  border-color: rgba(200,169,107,.28);
}
.member-badge.is-sky {
  background: rgba(58,112,155,.12);
  color: #2e638a;
  border-color: rgba(58,112,155,.16);
}
.member-badge.is-sand {
  background: rgba(171,125,64,.12);
  color: #7f5f30;
  border-color: rgba(171,125,64,.16);
}
.highlight-item {
  background: linear-gradient(135deg, rgba(123,196,127,.18), rgba(255,255,255,.95));
}
.role-explainer--co_owner {
  background: rgba(200,169,107,.14);
  border: 1px solid rgba(200,169,107,.24);
  color: #7a5a21;
}
.role-explainer--viewer {
  background: rgba(37,99,235,.10);
  border: 1px solid rgba(37,99,235,.18);
  color: #1e3a8a;
}
.friends-hero-card {
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
}
.portal-friends-page {
  gap: 22px;
}
.friends-section {
  position: relative;
  overflow: hidden;
  border-color: rgba(31,107,69,.10);
  background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(247,244,236,.9));
  box-shadow: 0 18px 40px rgba(15,23,42,.05);
}
.friends-section::before {
  content: "";
  position: absolute;
  inset: 0 0 auto;
  height: 1px;
  background: linear-gradient(90deg, rgba(123,196,127,0), rgba(123,196,127,.55), rgba(123,196,127,0));
  pointer-events: none;
}
.friends-section .section-head {
  position: relative;
  padding-bottom: 14px;
  margin-bottom: 18px !important;
  border-bottom: 1px solid rgba(31,107,69,.08);
}
.friends-section .section-head h3 {
  margin-top: 6px;
  letter-spacing: -.02em;
}
.friends-section .section-head p {
  max-width: 58ch;
  line-height: 1.65;
}
.friends-hero-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}
.friends-hero-stat {
  display: grid;
  gap: 8px;
  padding: 24px 26px;
  border-radius: 26px;
  background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(240,248,241,.92));
  border: 1px solid rgba(31,107,69,.12);
  box-shadow: 0 20px 44px rgba(15,23,42,.06);
}
.friends-hero-stat__value {
  font-family: "Be Vietnam Pro", sans-serif;
  font-size: 42px;
  line-height: .95;
  font-weight: 800;
  letter-spacing: -.03em;
  color: var(--forest-deep);
}
.friends-hero-stat__label {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: var(--text-soft);
}
.friends-explorer-card,
.friend-compose-card,
.friends-cta-card {
  border-radius: 24px;
}
.friends-explorer-card {
  padding: 20px;
  border: 1px solid rgba(31,107,69,.10);
  background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(250,247,241,.9));
  box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
}
.friends-discovery-section .form-stack {
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 12px;
}
.friends-discovery-section input[type="search"] {
  min-height: 48px;
  border-radius: 16px;
  padding-inline: 16px;
  background: rgba(255,255,255,.96);
}
.friends-chip-row {
  justify-content: flex-start;
}
.friend-directory-item,
.friend-request-item,
.current-friend-item {
  min-height: 100%;
  border-radius: 20px;
  transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}
.friend-directory-item:hover,
.friend-request-item:hover,
.current-friend-item:hover {
  transform: translateY(-2px);
  border-color: rgba(31,107,69,.16);
  box-shadow: 0 18px 32px rgba(15,23,42,.06);
}
.friend-directory-title {
  margin: 0;
  font-weight: 700;
  color: var(--forest-deep);
}
.friend-directory-item .social-item-main strong,
.friend-request-item .social-item-main strong,
.current-friend-item .social-item-main strong {
  font-size: 16px;
  line-height: 1.35;
}
.friend-directory-item .social-item-main p,
.friend-request-item .social-item-main p,
.current-friend-item .social-item-main p {
  color: rgba(36,49,39,.72);
  line-height: 1.65;
}
.friend-directory-item .social-actions,
.friend-request-item .social-actions,
.current-friend-item .social-actions {
  align-self: center;
}
.friend-directory-item .btn,
.friend-request-item .btn,
.current-friend-item .btn,
.friends-discovery-section .btn {
  min-height: 44px;
  border-radius: 14px;
  font-weight: 800;
  padding-inline: 16px;
}
.friends-discovery-section .btn-ghost {
  background: rgba(255,255,255,.74);
}
.friends-discovery-list,
.friends-invite-stack,
.current-friends-stack {
  gap: 16px;
  align-content: start;
}
.friends-discovery-list .friend-directory-item {
  background: linear-gradient(180deg, rgba(255,255,255,.97), rgba(242,248,243,.92));
}
.friends-invites-section .highlight-item {
  background: linear-gradient(135deg, rgba(123,196,127,.14), rgba(255,255,255,.96));
}
.member-badge {
  box-shadow: inset 0 1px 0 rgba(255,255,255,.45);
}
.friends-section .notice {
  border-radius: 18px;
  border: 1px dashed rgba(31,107,69,.18);
  background: rgba(246,250,246,.9);
}
.blynk-light-toggle.is-disabled,
.btn[disabled],
button[disabled] {
  opacity: .58;
  cursor: not-allowed;
  box-shadow: none;
}
.friends-section .btn[disabled],
.friends-section button[disabled] {
  filter: saturate(.7);
  background: linear-gradient(180deg, rgba(226,232,240,.92), rgba(241,245,249,.94));
  border-color: rgba(148,163,184,.26);
  color: #64748b;
}
.friends-cta-card {
  margin-top: 16px;
  padding: 18px 20px;
  border-radius: 24px;
  border: 1px solid rgba(31,107,69,.12);
  background: linear-gradient(135deg, rgba(235,247,236,.92), rgba(255,255,255,.88));
  display: grid;
  gap: 14px;
}
.member-group {
  display: grid;
  gap: 12px;
}
.member-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  padding-bottom: 4px;
}
.blynk-light-toggle.is-disabled,
.btn[disabled],
button[disabled] {
  opacity: .58;
  cursor: not-allowed;
  box-shadow: none;
}
.blynk-light-toggle.is-disabled {
  border-color: rgba(15,23,42,.08);
  background: rgba(148,163,184,.12);
  color: #475569;
}
@media (max-width: 640px) {
  .control-inline-block .toggle-row .blynk-light-toggle {
    border-radius: 16px;
    padding: 8px 10px;
  }
  .blynk-light-toggle .blynk-light-main {
    gap: 6px;
  }
  .blynk-light-toggle .blynk-light-sep {
    display: none;
  }
  .blynk-light-toggle .blynk-light-on,
  .blynk-light-toggle .blynk-light-off {
    flex-basis: calc(50% - 3px);
  }
  .portal-friends-page {
    gap: 18px;
  }
  .friends-hero-stats {
    grid-template-columns: 1fr;
  }
  .friends-hero-stat {
    padding: 18px 20px;
  }
  .friends-hero-stat__value {
    font-size: 32px;
  }
  .friends-section {
    padding: 20px 18px;
  }
  .friends-discovery-section .form-stack {
    grid-template-columns: 1fr;
  }
  .friend-directory-item,
  .friend-request-item,
  .current-friend-item {
    padding: 16px;
  }
  .friend-directory-item .social-item-main strong,
  .friend-request-item .social-item-main strong,
  .current-friend-item .social-item-main strong {
    font-size: 15px;
  }
}
@media (max-width: 820px) {
  .activity-row,
  .card-link-grid a,
  .auth-inline-meta,
  .portal-entry-card,
  .social-item,
  .social-actions,
  .portal-switcher-inline-meta { display: grid; }
  .stat-stack { grid-template-columns: 1fr; }
  .auth-card,
  .auth-card-strong,
  .auth-card-wide,
  .market-compose-dialog { padding: 22px; }
  .auth-actions,
  .portal-entry-actions { flex-direction: column; }
  .auth-actions .btn,
  .portal-entry-actions .btn,
  .social-actions .btn { width: 100%; }
  .market-compose-dialog { margin: 24px auto; }
  .market-compose-head-ai,
  .market-compose-toolbar,
  .market-compose-actions { display:grid; }
  .market-compose-actions .btn,
  .market-compose-upload { width: 100%; }
  .market-compose-status { white-space: normal; }
}
}
}


.control-panel-flat { margin-top: 14px; }
.control-tile-flat {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
  border-radius: 0 !important;
}
.control-tile-flat .control-tile-head-compact,
.control-tile-flat .control-environment-metrics,
.control-tile-flat .control-inline-note,
.control-tile-flat .control-inline-meta-row {
  background: transparent;
}
.control-tile-flat .control-environment-metrics {
  padding: 0;
}
.control-tile-flat .control-inline-note {
  padding-left: 0;
  padding-right: 0;
}
.pot-control-card {
  padding: 18px !important;
  border-radius: 22px !important;
  border: 1px solid rgba(31,107,69,.10) !important;
  background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(244,248,244,.96)) !important;
  box-shadow: 0 18px 36px rgba(15,23,42,.05) !important;
}
.pot-control-head {
  display: grid;
  grid-template-columns: minmax(0,1fr) auto;
  gap: 12px;
  align-items: start;
}
.pot-control-title {
  display: block;
  margin-top: 4px;
  font-size: 15px;
  line-height: 1.4;
  color: var(--forest-deep);
}
.pot-device-chips {
  justify-content: flex-end;
}
.pot-control-layout {
  display: grid;
  gap: 14px;
  margin-top: 14px;
}
.pot-control-section {
  display: grid;
  gap: 10px;
  padding: 14px;
  border-radius: 18px;
  border: 1px solid rgba(31,107,69,.08);
  background: rgba(248,250,248,.92);
}
.pot-control-section-label {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: rgba(36,49,39,.58);
}
.pot-metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 8px;
}
.pot-metric-grid .chip {
  min-height: 42px;
  display: flex;
  align-items: center;
}
.pot-control-status-list {
  display: grid;
  gap: 8px;
}
.pot-status-note {
  min-height: 42px;
  padding: 10px 12px;
  border-radius: 14px;
  border: 1px solid rgba(31,107,69,.08);
  background: rgba(255,255,255,.92);
}
.pot-control-buttons {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 12px;
  align-items: start;
}
.pot-control-button-group {
  display: grid;
  gap: 8px;
  min-width: 0;
}
.pot-control-button-label {
  font-size: 12px;
  font-weight: 700;
  color: var(--forest-deep);
}
.pot-control-button-group .blynk-light-toggle {
  width: 100%;
  max-width: none;
}
.pot-summary-note {
  line-height: 1.55;
}
@media (max-width: 820px) {
  .pot-control-head {
    grid-template-columns: minmax(0,1fr);
  }
  .pot-device-chips {
    justify-content: flex-start;
  }
  .pot-metric-grid,
  .pot-control-buttons {
    grid-template-columns: minmax(0,1fr);
  }
}
